<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <!-- Новый changeSet для изменения внешнего ключа -->
    <changeSet id="add-on-delete-cascade-to-schedule" author="uPagge">
        <!-- Удаляем старый внешний ключ -->
        <dropForeignKeyConstraint baseTableName="schedule" constraintName="fk_schedule_flight"/>

        <!-- Добавляем новый внешний ключ с onDelete="CASCADE" -->
        <addForeignKeyConstraint baseTableName="schedule"
                                 baseColumnNames="flight_id"
                                 constraintName="fk_schedule_flight"
                                 referencedTableName="flight"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>